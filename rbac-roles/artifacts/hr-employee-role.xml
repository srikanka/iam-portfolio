     Excerpt for review: not a complete importable object. Contains no credentials. -->
<role xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      xmlns:org="http://midpoint.evolveum.com/xml/ns/public/common/org-3"
      oid="e466540e-b10b-48cb-8afa-01ee2f48dfaa">
    <name>HR_Employee</name>
    <description>Assigned to all HR department employees</description>

    <assignment id="1">
        <targetRef oid="00000000-0000-0000-0000-000000000321" relation="org:default" type="c:ArchetypeType"/> <!-- Business role -->
    </assignment>
    <!-- Present on the role object itself (added during setup); it does not flow to members. Cleanup item. -->
    <assignment id="2">
        <targetRef oid="b8f0cc7f-121d-47be-9369-ae2a17d02c05" relation="org:default" type="c:RoleType"/> <!-- Employee -->
    </assignment>

    <!-- No inducement by design: this role records a business fact without granting a system entitlement. -->

    <autoassign>
        <enabled>true</enabled>
        <focus>
            <mapping id="11">
                <name>autoassign-hr</name>
                <strength>strong</strength>
                <source>
                    <path>organizationalUnit</path>
                </source>
                <condition>
                    <script>
                        <code>organizationalUnit == 'HR'</code>
                    </script>
                </condition>
            </mapping>
        </focus>
    </autoassign>
</role>
